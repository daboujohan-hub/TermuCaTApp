{
  "expo": {
    "name": "TermChat",
    "slug": "TermChatApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "termchatapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.aboudev.TermChatApp"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.aboudev.TermChatApp",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "Autoriser TermChat à accéder au micro pour enregistrer des messages vocaux."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Autoriser TermChat à accéder à votre position pour localiser les écoles à proximité."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser TermChat à accéder à tes photos pour changer ta photo de profil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/termchat_notif.mp3"
          ]
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4e2cf252-e9c9-40e6-96d0-1461c8834ca3"
      }
    },
    "owner": "aboudev"
  }
}
